{
  "name": "zanafleet",
  "version": "1.0.0",
  "description": "AI-accelerated, event-driven last-mile logistics platform for Africa",
  "author": "ZanaFleet Team",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build:packages": "npm run build:contracts && npm run build:utils",
    "build:contracts": "npm run build -w @zanafleet/contracts",
    "build:utils": "npm run build -w @zanafleet/utils",
    "build:domain": "npm run build -w @zanafleet/domain",
    "build": "npm run build:packages && nest build && node scripts/add-js-extensions.js dist/api",
    "build:api": "nest build",
    "build:legacy": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "tsc --noEmit -p apps/api/tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint \"apps/**/*.ts\"",
    "lint:check": "oxlint \"apps/**/*.ts\" --deny-warnings",
    "lint:legacy": "eslint \"apps/**/*.ts\" --fix",
    "lint:legacy:check": "eslint \"apps/**/*.ts\" --fix --rule \"@typescript-eslint/no-unnecessary-type-assertion: off\" --rule \"import/order: warn\"",
    "format": "prettier --write \"apps/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\"",
    "test": "jest --maxWorkers=50% --cache",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --maxWorkers=50% --cache",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --testPathPattern=\"\\.spec\\.ts$\" --testPathIgnore=\"integration\" --maxWorkers=50% --cache",
    "test:integration": "jest --config jest.integration.config.json --maxWorkers=50% --cache",
    "test:all": "jest --coverage --maxWorkers=50% --cache",
    "test:legacy": "jest",
    "test:legacy:unit": "jest --testPathPattern=\"\\.spec\\.ts$\" --testPathIgnore=\"integration\"",
    "test:legacy:integration": "jest --config jest.integration.config.json",
    "verify:contracts": "node scripts/verify-contracts.js",
    "ci:lint": "npm run format:check && npm run lint:check",
    "ci:lint:legacy": "npm run format:check && npm run lint:legacy:check",
    "ci:test": "npm run test:all",
    "ci:test:legacy": "npm run test:all",
    "ci:all": "npm run ci:lint && npm run verify:contracts && npm run ci:test",
    "ci:all:legacy": "npm run ci:lint:legacy && npm run verify:contracts && npm run ci:test:legacy",
    "prepare": "husky install",
    "postinstall": "npm --workspace @zanafleet/contracts run build && npm --workspace @zanafleet/utils run build"
  },
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@faker-js/faker": "^10.2.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.70.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^2.30.0",
    "h3-js": "^4.4.0",
    "ioredis": "^5.3.2",
    "json-logic-js": "^2.0.5",
    "keycloak-connect": "^25.0.6",
    "luxon": "^3.7.2",
    "nats": "^2.18.0",
    "neo4j-driver": "^5.0.0",
    "nest-keycloak-connect": "^1.9.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.10.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.2",
    "tigerbeetle-node": "0.16.70",
    "typeorm": "^0.3.16",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@playwright/test": "^1.58.2",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.15.13",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/json-logic-js": "^2.0.8",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.3.0",
    "neo-forgery": "^2.0.1",
    "oxlint": "^1.50.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
