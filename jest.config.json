{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!src/**/*.module.ts",
    "!src/main.ts",
    "!src/**/index.ts",
    "!src/**/*.interface.ts",
    "!src/**/*.entity.ts",
    "!src/**/*.event.ts",
    "!src/**/*.enum.ts",
    "!src/**/*.dto.ts"
  ],
  "coverageDirectory": "coverage",
  "testEnvironment": "node",
  "passWithNoTests": true,
  "roots": [
    "<rootDir>/src"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFilesAfterEnv": [
    "<rootDir>/test/jest-setup.ts"
  ],
  "testTimeout": 30000,
  "verbose": true,
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  }
}
