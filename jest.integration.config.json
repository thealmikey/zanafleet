{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "integration.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "swcrc": false,
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "tsx": false,
            "decorators": true,
            "dynamicImport": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          },
          "target": "es2020",
          "baseUrl": ".",
          "paths": {
            "@zanafleet/contracts": ["packages/contracts/dist/src"],
            "@zanafleet/contracts/*": ["packages/contracts/dist/src/*"],
            "@zanafleet/domain": ["packages/domain/dist/src"],
            "@zanafleet/domain/*": ["packages/domain/dist/src/*"],
            "@zanafleet/utils": ["packages/utils/dist"],
            "@zanafleet/utils/*": ["packages/utils/dist/*"],
            "@api/*": ["apps/api/src/*"]
          }
        },
        "module": {
          "type": "commonjs",
          "noInterop": false
        }
      }
    ]
  },
  "collectCoverageFrom": [
    "apps/api/src/**/*.(t|j)s",
    "!apps/api/src/**/*.module.ts",
    "!apps/api/src/main.ts",
    "!apps/api/src/**/index.ts",
    "!apps/api/src/**/*.interface.ts",
    "!apps/api/src/**/*.entity.ts",
    "!apps/api/src/**/*.event.ts",
    "!apps/api/src/**/*.enum.ts",
    "!apps/api/src/**/*.dto.ts"
  ],
  "coverageDirectory": "coverage",
  "testEnvironment": "node",
  "passWithNoTests": true,
  "roots": ["<rootDir>/apps/api/src"],
  "moduleNameMapper": {
    "^@api/(.*)$": "<rootDir>/apps/api/src/$1",
    "^@zanafleet/contracts$": "<rootDir>/packages/contracts/dist/src",
    "^@zanafleet/contracts/(.*)$": "<rootDir>/packages/contracts/dist/src/$1",
    "^@zanafleet/domain$": "<rootDir>/packages/domain/dist/src",
    "^@zanafleet/domain/(.*)$": "<rootDir>/packages/domain/dist/src/$1",
    "^@zanafleet/utils$": "<rootDir>/packages/utils/dist/src",
    "^@zanafleet/utils/(.*)$": "<rootDir>/packages/utils/dist/src/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/apps/api/test/jest-setup.ts"],
  "testTimeout": 30000,
  "verbose": true,
  "coverageThreshold": {},
  "maxWorkers": "50%",
  "cache": true
}
