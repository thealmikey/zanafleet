{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testRegex": "integration.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "apps/api/src/**/*.(t|j)s",
    "!apps/api/src/**/*.module.ts",
    "!apps/api/src/main.ts",
    "!apps/api/src/**/index.ts",
    "!apps/api/src/**/*.interface.ts",
    "!apps/api/src/**/*.entity.ts",
    "!apps/api/src/**/*.event.ts",
    "!apps/api/src/**/*.enum.ts",
    "!apps/api/src/**/*.dto.ts"
  ],
  "coverageDirectory": "coverage",
  "testEnvironment": "node",
  "passWithNoTests": true,
  "roots": [
    "<rootDir>/apps/api/src"
  ],
  "moduleNameMapper": {
    "^@api/(.*)$": "<rootDir>/apps/api/src/$1",
    "^@zanafleet/contracts$": "<rootDir>/packages/contracts/src",
    "^@zanafleet/contracts/(.*)$": "<rootDir>/packages/contracts/src/$1",
    "^@zanafleet/domain$": "<rootDir>/packages/domain/src",
    "^@zanafleet/domain/(.*)$": "<rootDir>/packages/domain/src/$1",
    "^@zanafleet/utils$": "<rootDir>/packages/utils/src",
    "^@zanafleet/utils/(.*)$": "<rootDir>/packages/utils/src/$1"
  },
  "setupFilesAfterEnv": [
    "<rootDir>/apps/api/test/jest-setup.ts"
  ],
  "testTimeout": 30000,
  "verbose": true,
  "coverageThreshold": {}
}
