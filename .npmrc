# ZanaFleet npm Configuration
# Ensures consistent npm behavior across different environments

# Use exact versions from package-lock.json
ci-strict=true

# Use package-lock.json for installations
package-lock=true

# Fail on npm audit warnings during CI
audit-level=moderate

# Disable funding messages
fund=false

# Set registry (uncomment and modify for private registry)
# registry=https://registry.npmjs.org/

# Legacy peer deps handling (if needed)
# legacy-peer-deps=true
