# ZanaFleet npm Configuration
# Ensures consistent npm behavior across different environments

# Note: CI uses `npm ci` which enforces strict lock file validation
# Local development uses `npm install` which allows lock file updates
# ci-strict=true  # Disabled - causes friction during local development

# Use package-lock.json for installations
package-lock=true

# Security audit level (commented out for local dev flexibility)
# CI enforces audits separately; use `npm install --no-audit` if blocked locally
# audit-level=moderate

# Disable funding messages
fund=false

# Set registry (uncomment and modify for private registry)
# registry=https://registry.npmjs.org/

# Legacy peer deps handling (if needed)
# legacy-peer-deps=true
