{
  "name": "@zanafleet/contracts",
  "version": "0.0.1",
  "description": "Shared DTOs, event interfaces, and type definitions for ZanaFleet",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --extensions .ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
