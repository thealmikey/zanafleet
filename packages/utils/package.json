{
  "name": "@zanafleet/utils",
  "version": "0.0.1",
  "description": "Utility functions and helpers for ZanaFleet",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/add-cjs-exports.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^9.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
