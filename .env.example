# =============================================================================
# ZanaFleet Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (REQUIRED - change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Token expiration time (default: 1h)
# Examples: 60s, 15m, 1h, 7d
JWT_EXPIRATION=1h

# Token issuer identifier
JWT_ISSUER=zanafleet

# -----------------------------------------------------------------------------
# Keycloak Configuration
# -----------------------------------------------------------------------------
# Keycloak realm name
KEYCLOAK_REALM=zanafleet

# Keycloak server URL (without trailing slash)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080

# Client ID registered in Keycloak
KEYCLOAK_CLIENT_ID=zanafleet-api

# Client secret for confidential clients
KEYCLOAK_SECRET=your-keycloak-client-secret

# Bearer-only mode (true = API only, no login redirect)
KEYCLOAK_BEARER_ONLY=true

# -----------------------------------------------------------------------------
# User Sync Configuration
# -----------------------------------------------------------------------------
# Default workspace ID for new Keycloak users
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Frontend API Configuration
# -----------------------------------------------------------------------------
# Backend API URL for development proxy (used by setupProxy.js)
# In development: Used as the target for the /api proxy (default: http://localhost:3001)
# In production: Set to the full backend URL (e.g., https://api.zanafleet.com)
# REACT_APP_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Frontend Keycloak Configuration
# -----------------------------------------------------------------------------
# Keycloak server URL for frontend (React apps require REACT_APP_ prefix)
REACT_APP_KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name for frontend
REACT_APP_KEYCLOAK_REALM=zanafleet

# Public client ID for the web application (different from backend confidential client)
REACT_APP_KEYCLOAK_CLIENT_ID=zanafleet-web

# -----------------------------------------------------------------------------
# NATS Configuration
# -----------------------------------------------------------------------------
# NATS server URL for the event bus
NATS_URL=nats://localhost:4222

# =============================================================================
# Media Perception Configuration
# =============================================================================
# Master toggle for media perception feature (default: false for safety)
MEDIA_PERCEPTION_ENABLED=false

# Minimum confidence (0-1) for media insights to be used (default: 0.7)
MEDIA_PERCEPTION_CONFIDENCE_THRESHOLD=0.7

# Confidence threshold for AI to override legacy recommendations (default: 0.85)
MEDIA_PERCEPTION_OVERRIDE_THRESHOLD=0.85

# Timeout for media analysis in milliseconds (default: 30000)
MEDIA_PERCEPTION_TIMEOUT_MS=30000

# Enable async processing - booking returns immediately, analysis in background (default: true)
MEDIA_PERCEPTION_ASYNC=true

# Vision provider: openai, google, azure, noop (default: noop)
MEDIA_PERCEPTION_PROVIDER=noop

# Feature flags for specific capabilities (default: true for all)
MEDIA_FEATURE_VOLUME=true
MEDIA_FEATURE_LABOR=true
MEDIA_FEATURE_FRAGILITY=true
MEDIA_FEATURE_ITEMS=true

# -----------------------------------------------------------------------------
# OpenAI Configuration (required if MEDIA_PERCEPTION_PROVIDER=openai)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
