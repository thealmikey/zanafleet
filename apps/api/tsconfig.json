{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "../../dist/apps/api",
    "paths": {
      "@api/*": [
        "./*"
      ],
      "@zanafleet/contracts": [
        "../../packages/contracts/src"
      ],
      "@zanafleet/contracts/*": [
        "../../packages/contracts/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}