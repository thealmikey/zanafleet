{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "../../dist/apps/api",
    "paths": {
      "@api/*": [
        "./*"
      ],
      "@zanafleet/contracts": [
        "../../packages/contracts/dist"
      ],
      "@zanafleet/contracts/*": [
        "../../packages/contracts/dist/*"
      ],
      "@zanafleet/utils": [
        "../../packages/utils/dist"
      ],
      "@zanafleet/utils/*": [
        "../../packages/utils/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}