{
  "name": "zanafleet-frontend",
  "version": "1.0.0",
  "description": "ZanaFleet React frontend with MUI",
  "private": true,
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "test:e2e": "mocha --config tests/e2e/.mocharc.json",
    "test:e2e:headed": "mocha --config tests/e2e/.mocharc.json --headed",
    "test:visual": "playwright test tests/visual",
    "test:visual:headed": "playwright test tests/visual --headed",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:check": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@faker-js/faker": "^10.2.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^6.18.0",
    "@react-google-maps/api": "^2.20.8",
    "@xyflow/react": "^12.10.0",
    "@zanafleet/contracts": "*",
    "chart.js": "^4.4.1",
    "date-fns": "^3.6.0",
    "keycloak-js": "^26.2.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/selenium-webdriver": "^4.35.5",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "chai": "^6.2.2",
    "chromedriver": "^144.0.1",
    "eslint": "^8.42.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "http-proxy-middleware": "^2.0.6",
    "mocha": "^11.7.5",
    "msw": "^2.0.0",
    "playwright": "^1.58.2",
    "prettier": "^2.8.8",
    "react-scripts": "^5.0.1",
    "selenium-webdriver": "^4.41.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
