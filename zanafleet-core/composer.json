{
    "name": "zanafleet/core",
    "description": "ZanaFleet PHP SDK - Platform-agnostic library for e-commerce delivery integration",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ZanaFleet\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZanaFleet\\Core\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.4|^8.0",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "suggest": {
        "psr/log": "For injectable logging interface"
    },
    "minimum-stability": "stable",
    "keywords": [
        "delivery",
        "logistics",
        "ecommerce",
        "shipping",
        "woocommerce",
        "magento",
        "zanafleet"
    ]
}